{
  "name": "@shubhamtaywade82/dhanhq-ts",
  "version": "0.2.0",
  "description": "TypeScript SDK for the DhanHQ v2 API \u2014 REST, WebSocket, technical analysis, option analytics, risk pipeline, composable trading skills, agent tools and an MCP server.",
  "keywords": [
    "dhan",
    "dhanhq",
    "trading",
    "nse",
    "bse",
    "options",
    "technical-analysis",
    "mcp",
    "agent",
    "broker-api"
  ],
  "license": "MIT",
  "author": "Shubham Taywade <shubhamtaywade82@gmail.com>",
  "homepage": "https://github.com/shubhamtaywade82/dhanhq-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/dhanhq-ts.git"
  },
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/dhanhq-ts/issues"
  },
  "type": "commonjs",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp/index.d.mts",
        "default": "./dist/mcp/index.mjs"
      },
      "require": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "mcp": [
        "dist/mcp/index.d.ts"
      ]
    }
  },
  "bin": {
    "dhanhq-mcp": "dist/bin/dhanhq-mcp.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "smoke": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/smoke-test.ts",
    "generate": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/generate-sdk.ts",
    "mcp": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' src/bin/dhanhq-mcp.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bottleneck": "^2.19.5",
    "events": "^3.3.0",
    "form-data": "^4.0.6",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "jest": "^30.3.0",
    "openapi-typescript-codegen": "^0.30.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
