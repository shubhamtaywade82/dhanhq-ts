{
  "name": "@dhanhq/client",
  "version": "0.2.0",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/dhanhq-ts.git"
  },
  "homepage": "https://github.com/shubhamtaywade82/dhanhq-ts",
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/dhanhq-ts/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "smoke": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/smoke-test.ts",
    "generate": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/generate-sdk.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mcp": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' src/bin/dhanhq-mcp.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bottleneck": "^2.19.5",
    "events": "^3.3.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "jest": "^30.3.0",
    "openapi-typescript-codegen": "^0.30.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "description": "TypeScript SDK for the DhanHQ v2 API \u2014 REST, WebSocket, technical analysis, option analytics, risk pipeline, composable trading skills, agent tools and an MCP server.",
  "keywords": [
    "dhan",
    "dhanhq",
    "trading",
    "nse",
    "bse",
    "options",
    "technical-analysis",
    "mcp",
    "agent",
    "broker-api"
  ],
  "license": "MIT",
  "bin": {
    "dhanhq-mcp": "dist/bin/dhanhq-mcp.cjs"
  }
}
